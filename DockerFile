# Use the exact Python version you used for development
FROM python:3.11.9-slim

# Install system dependencies, including those for compiling R packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base \
    r-base-dev \
    git-annex \
    wget \
    curl \
    git \
    bash \
    libssl-dev \
    libcurl4-openssl-dev \
    libxml2-dev \
    libnlopt-dev \          
    libgsl-dev \             
    libfftw3-dev \           
    cmake \                  
    gfortran \               
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install BayesFactor and its dependencies
# Use multiple cores to speed up compilation, and install nloptr first to catch errors early
RUN Rscript -e "install.packages('nloptr', repos='https://cloud.r-project.org/', Ncpus=4)" \
    && Rscript -e "install.packages('BayesFactor', repos='https://cloud.r-project.org/', dependencies=TRUE, Ncpus=4)" \
    && Rscript -e "library(BayesFactor)"

# Set working directory
WORKDIR /app

# Install Python packages (list from your readme)
RUN pip install --no-cache-dir \
    mne \
    numpy \
    pandas \
    scipy \
    scikit-learn \
    pingouin \
    matplotlib \
    seaborn \
    ptitprince \
    rpy2 \
    tqdm \
    joblib \
    datalad

# Copy the entire project into the container
COPY . /app

# Make the download script executable
RUN chmod +x /app/download_data.sh

# Set the entrypoint to run the download script and then the pipeline
ENTRYPOINT ["/app/download_data.sh"]